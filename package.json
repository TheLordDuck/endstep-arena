{
  "name": "endstep-arena-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium extension that layers a modern, Arena-style game UI on top of endstep.cc",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "build:dev": "node build.mjs --dev",
    "package": "node build.mjs && node tools/package.mjs",
    "dev-server": "node tools/dev-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --test \".test-dist/*.test.mjs\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
